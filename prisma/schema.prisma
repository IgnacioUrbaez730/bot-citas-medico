generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Doctor {
  id             String        @id @default(uuid())
  auth_id        String        @unique
  name           String
  specialty      String?
  medicalLicense String?
  clinicName     String?
  clinicAddress  String?
  workStartTime  String        @default("08:00")
  workEndTime    String        @default("17:00")
  scheduleText   String?       @default("Lunes a Viernes de 8:00 AM a 5:00 PM")
  slotDuration   Int           @default(30)
  createdAt      DateTime      @default(now())
  appointments   Appointment[]
  patients       Patient[]
}

model Contact {
  phone      String       @id
  name       String?      // Nombre legal del titular (opcional/manual)
  nationalId String?      // Cédula/DNI del titular del WhatsApp
  alias      String?      // Nombre asignado por el doctor manualmente
  aiName     String?      // Nombre extraído automáticamente por la IA
  createdAt  DateTime     @default(now())
  
  patients   Patient[]
  messages   Message[]
  sessions   BotSession[]
}

model Patient {
  id           String        @id @default(uuid())
  doctorId     String
  contactPhone String?       // Referencia al dueño del teléfono (representante)
  name         String?       // Nombre real del paciente
  nationalId   String?       // Cédula del paciente
  birthDate    DateTime?     // Fecha de nacimiento
  gender       String?       // Sexo biológico (ej. M, F)
  bloodType    String?       // Grupo Sanguíneo (ej. O+, A-)
  email        String?       // Correo electrónico (para enviar PDFs)
  occupation   String?       // Ocupación / Profesión
  address      String?       // Dirección / Ciudad
  emergencyContact String?   // Nombre y teléfono de emergencia
  createdAt    DateTime      @default(now())
  
  appointments Appointment[]
  medicalBackground MedicalBackground?
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  contact      Contact?      @relation(fields: [contactPhone], references: [phone]) // Opcional temporalmente para migrar
}

model Appointment {
  id           String            @id @default(uuid())
  doctorId     String
  patientId    String
  dateTime     DateTime
  status       AppointmentStatus @default(PENDING)
  reason       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  clinicalNote ClinicalNote?

  @@unique([doctorId, dateTime])
}

model ClinicalNote {
  id              String      @id @default(uuid())
  appointmentId   String      @unique
  audioUrl        String?
  soapData        Json?
  prescriptionUrl String?
  isSigned        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
}

model BotSession {
  phone        String   @id
  doctorId     String
  step         String   @default("WELCOME")
  temporalData Json?
  updatedAt    DateTime @updatedAt

  contact      Contact? @relation(fields: [phone], references: [phone]) // Opcional para migrar
}

model Message {
  id        String   @id @default(uuid())
  phone     String
  sender    String
  text      String
  createdAt DateTime @default(now())

  contact   Contact? @relation(fields: [phone], references: [phone]) // Opcional para migrar
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}


model MedicalBackground {
  id              String   @id @default(uuid())
  patientId       String   @unique
  allergies       String?  @default("Ninguna conocida")
  personalHistory String?  // Patológicos personales
  familyHistory   String?  // Patológicos familiares
  surgicalHistory String?  // Quirúrgicos y traumatológicos
  habits          String?  // Hábitos tóxicos
  observations    String?  // Alertas (ej. marcapasos, alergias graves)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}
